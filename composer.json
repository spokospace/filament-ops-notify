{
    "name": "spokospace/filament-ops-notify",
    "description": "Operational notifications (inquiries, errors, builds) and chat commands for Laravel + Filament panels, delivered through Telegram.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["laravel", "filament", "telegram", "notifications", "alerts", "chatops"],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Spokospace\\OpsNotify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spokospace\\OpsNotify\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Spokospace\\OpsNotify\\OpsNotifyServiceProvider"
            ],
            "aliases": {
                "OpsNotify": "Spokospace\\OpsNotify\\Facades\\OpsNotify"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
