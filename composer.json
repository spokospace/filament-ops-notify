{
    "name": "spokospace/filament-ops-notify",
    "description": "Operational notifications (inquiries, errors, builds) for Laravel + Filament panels, delivered to Telegram forum topics.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/spokospace/filament-ops-notify",
    "authors": [
        {
            "name": "spoko.space",
            "homepage": "https://spoko.space"
        }
    ],
    "support": {
        "issues": "https://github.com/spokospace/filament-ops-notify/issues",
        "source": "https://github.com/spokospace/filament-ops-notify",
        "docs": "https://github.com/spokospace/filament-ops-notify/tree/main/docs"
    },
    "keywords": ["laravel", "filament", "filament-plugin", "telegram", "telegram-bot", "notifications", "alerts", "monitoring"],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Spokospace\\OpsNotify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spokospace\\OpsNotify\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Spokospace\\OpsNotify\\OpsNotifyServiceProvider"
            ],
            "aliases": {
                "OpsNotify": "Spokospace\\OpsNotify\\Facades\\OpsNotify"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
